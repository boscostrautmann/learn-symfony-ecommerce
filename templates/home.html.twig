	<div class="row">
		{% include "shared/_assurance.html.twig" with {
			'color': 'primary',
			'icone': "fas fa-truck",
			'text': "Lorem ipsum, dolor sit amet consectetur adipisicing elit. Harum voluptatem, recusandae doloremque ipsum impedit voluptatibus.",
		} %}
		{% include "shared/_assurance.html.twig" with {
