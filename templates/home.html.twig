{% extends "base.html.twig" %}

{% block title %}Acceuil
{% endblock %}

{% block body %}
	<h1>Nos produits phares</h1>
	<div class="row">
		{% for item in 1..3 %}
			<div class="col">
				<div class="card">
					<img src="https://picsum.photos/200/200" class="img-fluid" alt="Image du produit">
					<div class="card-body">
						<h4 class="card-title">Superbe Chaise en Bois</h4>
						<p class="card-text">Lorem, ipsum dolor sit amet consectetur adipisicing elit. Cumque, eos!</p>
						<a class="btn btn-primary btn-sm" href="#">Détails</a>
						<a class="btn btn-success btn-sm" href="#">Ajouter</a>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
	<hr>
	<h2>Un service irreprochable</h2>
	<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Ratione omnis aspernatur fugiat numquam doloremque excepturi.</p>

	<div class="row">
		{% include "shared/_assurance.html.twig" with {
			'color': 'primary',
			'icone': "fas fa-truck",
			'text': "Lorem ipsum, dolor sit amet consectetur adipisicing elit. Harum voluptatem, recusandae doloremque ipsum impedit voluptatibus.",
		} %}
		{% include "shared/_assurance.html.twig" with {
			'color': 'success',
			'icone': "fas fa-check",
			'text': "Lorem ipsum, dolor sit amet consectetur adipisicing elit. Harum voluptatem, recusandae doloremque ipsum impedit voluptatibus.",
		} %}
		{% include "shared/_assurance.html.twig" with {
			'color': 'warning',
			'icone': "fas fa-lock",
			'text': "Lorem ipsum, dolor sit amet consectetur adipisicing elit. Harum voluptatem, recusandae doloremque ipsum impedit voluptatibus.",
		} %}
	</div>
{% endblock %}
